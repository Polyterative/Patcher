{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "patcher-image-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "images.patcher.xyz",
      "custom_domain": true
    }
  ],
  "vars": {
    "SUPABASE_STORAGE_ORIGIN": "https://sozmatmywjpstwidzlss.supabase.co/storage/v1/object/public",
    "ALLOWED_BUCKETS": "module-panels,racks,manufacturer-logos,module-collections,patches",
    "BROWSER_CACHE_TTL_SECONDS": "604800",
    "EDGE_CACHE_TTL_SECONDS": "2592000"
  }
}
