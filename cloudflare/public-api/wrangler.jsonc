{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "patcher-public-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "API_KEY_COUNTER",
        "class_name": "ApiKeyCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ApiKeyCounter"]
    }
  ]
}
