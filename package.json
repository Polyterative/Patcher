{
  "name": "patcher",
  "version": "6.7.18",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "prestart": "node generate-env.js",
    "start": "ng serve --port 5556",
    "start:ssr": "ng serve --configuration ssr --port 5556",
    "startProd": "ng serve --configuration production --hmr",
    "prebuild": "node generate-env.js",
    "build": "pnpm prebuild && angular-build-info && node scripts/build/generate-prerender-routes.mjs && ng build --configuration production",
    "build:release": "pnpm build && pnpm sentry:sourcemaps",
    "bundle-report": "ng build --configuration=production --stats-json && webpack-bundle-analyzer dist/Patcher/stats.json",
    "perf:measure": "node scripts/perf/measure-flow.mjs",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org patcher --project patcher-xyz ./dist/Patcher && sentry-cli sourcemaps upload --org patcher --project patcher-xyz ./dist/Patcher",
    "copyChangelog": "cp CHANGELOG.md src/assets/md/changelog.md",
    "lint": "ng lint && node scripts/checks/check-route-module-imports.cjs && node scripts/checks/check-layering.cjs && node scripts/checks/check-explicit-any.cjs && node scripts/checks/check-docs.cjs && node scripts/checks/check-scss-global-imports.cjs && node scripts/checks/check-dep-duplicates.cjs && bash scripts/checks/check-posthog-imports.sh",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:px": "bash scripts/checks/check-px-ts.sh $(find src -name '*.ts' -not -path '*/node_modules/*')",
    "loop:health": "node scripts/dev/loop-health.mjs",
    "px-to-rem": "node scripts/dev/px-to-rem.mjs",
    "px-to-rem:write": "node scripts/dev/px-to-rem.mjs --write",
    "ci": "pnpm test-headless",
    "check:bundle": "node scripts/checks/check-bundle-singletons.cjs",
    "test": "pnpm test:unit",
    "test:unit": "ng test --browsers=ChromeHeadlessCI",
    "test-headless": "pnpm test:unit:headless",
    "test:unit:headless": "ng test --browsers=ChromeHeadlessCI --watch=false",
    "test:unit:ci": "ng test --browsers=ChromeHeadlessCI --watch=false --code-coverage",
    "test:functions": "pnpm test:functions:middleware && pnpm test:functions:sitemap && pnpm test:functions:prerender-routes && pnpm test:functions:image-metadata && pnpm test:functions:public-id-migrations && pnpm test:functions:patch-preview-migrations && pnpm test:functions:public-open-api-migrations && pnpm test:functions:reactions-migration && pnpm test:functions:module-port-directions && pnpm test:functions:shipping-addresses-migration && pnpm test:functions:marketplace-listings-migration && pnpm test:functions:generate-env && pnpm test:functions:vercel-ignore-build && pnpm test:functions:e2e-module-create-safety && pnpm test:functions:panel-ratio-audit && pnpm test:functions:public-storage-media-audit && pnpm test:functions:r2-public-media-staging && pnpm test:functions:cloudflare-image-proxy && pnpm test:functions:public-api-worker && pnpm test:functions:public-api-live-smoke && pnpm test:functions:public-storage-referrer-policy && pnpm test:functions:price-hub-parser && pnpm test:functions:price-hub-worker && pnpm test:functions:price-hub-change-planner && pnpm test:functions:price-hub-local-crawler && pnpm test:functions:price-hub-import-local && pnpm test:functions:perf-measure && pnpm test:functions:e2e-local-dev-server && pnpm test:functions:e2e-hard-timeout-runner && pnpm test:functions:e2e-port-cleanup && pnpm test:functions:check-regression-contract",
    "test:functions:middleware": "node scripts/tests/run-function-test.cjs middleware.ts tmp/middleware-test scripts/tests/middleware.test.cjs",
    "test:functions:sitemap": "node scripts/tests/run-function-test.cjs api/sitemap.ts tmp/sitemap-test scripts/tests/sitemap.test.cjs",
    "test:functions:prerender-routes": "node --test scripts/tests/prerender-routes.test.mjs",
    "test:functions:image-metadata": "node --test scripts/tests/image-metadata.test.cjs",
    "test:functions:public-id-migrations": "node --test scripts/tests/public-id-migrations.test.cjs",
    "test:functions:patch-preview-migrations": "node --test scripts/tests/patch-preview-migrations.test.cjs",
    "test:functions:reactions-migration": "node --test scripts/tests/reactions-migration.test.cjs",
    "test:functions:module-port-directions": "node --test scripts/tests/module-port-directions-migration.test.cjs",
    "test:functions:shipping-addresses-migration": "node --test scripts/tests/shipping-addresses-migration.test.cjs",
    "test:functions:marketplace-listings-migration": "node --test scripts/tests/marketplace-listings-migration.test.cjs",
    "test:functions:generate-env": "node --test scripts/tests/generate-env.test.cjs",
    "test:functions:vercel-ignore-build": "node --test scripts/tests/vercel-ignore-build.test.cjs",
    "test:functions:e2e-module-create-safety": "node --test scripts/tests/e2e-module-create-safety.test.cjs",
    "test:functions:panel-ratio-audit": "node --test scripts/tests/panel-ratio-audit.test.mjs",
    "test:functions:public-storage-media-audit": "node --test scripts/tests/public-storage-media-audit.test.mjs",
    "test:functions:r2-public-media-staging": "node --test scripts/tests/r2-public-media-staging.test.mjs",
    "test:functions:cloudflare-image-proxy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/tests/cloudflare-image-proxy.test.mjs",
    "test:functions:public-api-worker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/tests/public-api-worker.test.mjs",
    "test:functions:public-api-live-smoke": "node --test scripts/tests/public-api-live-smoke.test.mjs",
    "test:public-api-smoke": "node scripts/tests/public-api-live-smoke.mjs",
    "test:functions:public-storage-referrer-policy": "node --test scripts/tests/public-storage-referrer-policy.test.mjs",
    "test:functions:e2e-local-dev-server": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/tests/local-dev-server.test.mjs",
    "test:functions:e2e-hard-timeout-runner": "node --test scripts/tests/hard-timeout-runner.test.mjs",
    "test:functions:e2e-port-cleanup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/tests/e2e-port-cleanup.test.mjs",
    "test:functions:price-hub-parser": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/tests/woocommerce-store-api-normalizer.test.mjs",
    "test:functions:price-hub-worker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/tests/snapshot-worker.test.mjs",
    "test:functions:price-hub-change-planner": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/tests/snapshot-change-planner.test.mjs",
    "test:ssr": "pnpm build && node scripts/tests/ssr-smoke.mjs",
    "test:ssr:smoke": "node scripts/tests/ssr-smoke.mjs",
    "test:ci:full": "pnpm test:functions && pnpm test:unit:ci",
    "e2e": "pnpm test:e2e",
    "check:e2e-module-create-safety": "node scripts/checks/e2e-module-create-safety.cjs",
    "pretest:e2e": "pnpm check:e2e-module-create-safety && pnpm exec playwright install chromium",
    "test:e2e": "node scripts/ops/run-e2e.mjs --reporter=list --project=chromium",
    "pretest:e2e:auth": "pnpm check:e2e-module-create-safety && pnpm exec playwright install chromium",
    "test:e2e:auth": "node scripts/ops/run-e2e-auth.mjs",
    "pretest:e2e:screenshots": "pnpm check:e2e-module-create-safety && pnpm exec playwright install chromium",
    "test:e2e:screenshots": "node scripts/ops/run-e2e-screenshots.mjs",
    "pretest:e2e:ci": "pnpm check:e2e-module-create-safety && pnpm exec playwright install chromium",
    "test:e2e:ci": "node scripts/ops/run-e2e.mjs --reporter=list --workers=1",
    "test:e2e:prod": "pnpm build && pnpm test:e2e:prod:run",
    "test:e2e:prod:run": "playwright test --config=playwright.prod.config.ts",
    "backup:data": "bash scripts/ops/backup-data.sh",
    "backup:data:dry-run": "bash scripts/ops/backup-data.sh --dry-run",
    "audit:panel-ratios": "node scripts/audits/audit-panel-ratios.mjs",
    "restore:data": "bash scripts/ops/restore-data.sh",
    "release:preflight": "node scripts/build/release-preflight.mjs",
    "testRelease:patch": "pnpm release:preflight && standard-version --release-as patch --dry-run && git push --dry-run --atomic --follow-tags origin production",
    "testRelease:minor": "pnpm release:preflight && standard-version --release-as minor --dry-run && git push --dry-run --atomic --follow-tags origin production",
    "release:patch": "pnpm release:preflight && standard-version --release-as patch --commit-all && git push --atomic --follow-tags origin production",
    "release:minor": "pnpm release:preflight && standard-version --release-as minor --commit-all && git push --atomic --follow-tags origin production",
    "release:major": "pnpm release:preflight && standard-version --release-as major --commit-all && git push --atomic --follow-tags origin production",
    "updateBackendTypes": "bash scripts/ops/update-backend-types.sh",
    "git:untrack-e2e-artifacts": "git rm -r --cached test-results/ playwright-report/ e2e/flow-0*.spec.ts 2>/dev/null || true",
    "switch:develop": "git update-index --no-skip-worktree src/build.ts && git checkout -- src/build.ts && git checkout develop && git update-index --skip-worktree src/build.ts",
    "switch:production": "git update-index --no-skip-worktree src/build.ts && git checkout -- src/build.ts && git checkout production && git update-index --skip-worktree src/build.ts",
    "merge:prod-to-dev": "pnpm switch:develop && git merge production",
    "merge:dev-to-prod": "pnpm switch:production && git merge develop",
    "prepare": "husky",
    "sync:docs-screenshots": "node scripts/dev/sync-docs-screenshots.mjs",
    "price-hub:crawl-local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/price-hub/crawl-local.ts",
    "price-hub:import-local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/price-hub/import-local-snapshots.ts",
    "price-hub:refresh-local": "node --max-old-space-size=8192 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/price-hub/refresh-local.ts",
    "audit:public-storage-media": "node scripts/audits/audit-public-storage-media.mjs",
    "r2:stage-public-media": "node scripts/ops/r2-stage-public-media.mjs",
    "cloudflare:image-proxy:deploy": "pnpm dlx wrangler@latest deploy --config cloudflare/image-proxy/wrangler.jsonc",
    "test:functions:price-hub-local-crawler": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/tests/price-hub-local-crawler.test.mjs",
    "test:functions:price-hub-import-local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/tests/price-hub-import-local.test.mjs",
    "test:functions:public-open-api-migrations": "node --test scripts/tests/public-open-api-migrations.test.cjs",
    "test:functions:perf-measure": "node --test scripts/tests/perf-measure-flow.test.mjs",
    "test:functions:check-regression-contract": "node --test scripts/tests/check-regression-contract.test.cjs"
  },
  "lint-staged": {
    "src/**/*.scss": [
      "stylelint --allow-empty-input"
    ],
    "src/**/*.ts": [
      "bash scripts/checks/check-px-ts.sh",
      "node scripts/checks/check-explicit-any.cjs --staged",
      "node scripts/checks/check-regression-contract.cjs --staged"
    ]
  },
  "standard-version": {
    "scripts": {
      "postchangelog": "cp CHANGELOG.md src/assets/md/changelog.md",
      "precommit": "git add src/assets/md/changelog.md"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/cdk": "^22.0.4",
    "@angular/cdk-experimental": "^22.0.4",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/material": "^22.0.4",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-browser-dynamic": "^22.0.8",
    "@angular/platform-server": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/ssr": "^22.0.8",
    "@ngx-pwa/local-storage": "^22.0.0",
    "@sentry/angular": "^10.58.0",
    "@sentry/browser": "^10.58.0",
    "@sentry/cli": "^2.38.0",
    "@supabase/supabase-js": "^2.46.1",
    "graphology": "^0.24.1",
    "graphology-layout-forceatlas2": "^0.8.2",
    "lottie-web": "^5.12.2",
    "luxon": "^3.4.4",
    "luxon-angular": "^6.0.0",
    "modern-screenshot": "^4.7.0",
    "ngx-image-cropper": "9.1.6",
    "ngx-lottie": "^21.2.0",
    "ngx-pipes": "^3.2.2",
    "ngx-timeago": "^4.1.0",
    "postgres": "^3.4.5",
    "posthog-js": "^1.390.2",
    "rxjs": "^7.8.2",
    "sigma": "^2.2.0",
    "ts-cacheable": "^1.0.10",
    "tslib": "^2.3.1",
    "unique-names-generator": "^4.7.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.0.0",
    "@angular-eslint/eslint-plugin": "22.0.0",
    "@angular-eslint/eslint-plugin-template": "22.0.0",
    "@angular-eslint/schematics": "22.0.0",
    "@angular-eslint/template-parser": "22.0.0",
    "@angular/build": "22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.8",
    "@angular/language-service": "^22.0.8",
    "@babel/core": "7.29.7",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.61.1",
    "@types/express": "^5.0.6",
    "@types/jasmine": "^3.10.3",
    "@types/jasminewd2": "^2.0.10",
    "@types/luxon": "^2.3.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@typescript-eslint/types": "^8.62.1",
    "@typescript-eslint/utils": "^8.62.1",
    "angular-build-info": "^2.0.1",
    "body-parser": "1.20.5",
    "dompurify": "^3.4.13",
    "engine.io": "6.6.9",
    "esbuild": "0.28.1",
    "eslint": "^10.6.0",
    "express": "^4.22.2",
    "express-rate-limit": "8.5.2",
    "fast-uri": "3.1.5",
    "husky": "^9.1.7",
    "ip-address": "10.3.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^4.0.1",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "lint-staged": "^16.2.7",
    "postcss": "8.5.23",
    "postcss-scss": "^4.0.9",
    "qs": "6.15.2",
    "shell-quote": "1.9.0",
    "simple-icons": "^16.23.0",
    "socket.io-adapter": "2.5.8",
    "socks": "2.8.9",
    "standard-version": "^9.5.0",
    "stylelint": "^17.14.0",
    "tmp": "0.2.7",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "webpack-dev-server": "6.0.0",
    "ws": "8.21.0"
  }
}
