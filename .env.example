# Patcher environment template.
# Copy this file to .env for local development, then fill values from your own Supabase project and test account.
# Never commit real credentials or personal/shared account passwords.

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side local scripts only. Never expose this in generated Angular environment files.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_DB_URL=
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
