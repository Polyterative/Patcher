            "type": "postgres",
            "uid": "patcher-pg"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(sum(used), 0) as calls from public.api_key_usage_monthly where month = date_trunc('month', now())::date"
