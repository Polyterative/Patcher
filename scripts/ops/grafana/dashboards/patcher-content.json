    {
      "id": 7,
      "title": "New modules per day",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "patcher-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "patcher-pg"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select $__timeGroup(created, '1d') as time, count(*) as modules\nfrom public.modules where $__timeFilter(created) group by 1 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "barAlignment": 0,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Includes bulk catalogue imports (spikes on 2022-01-09, 2026-03-09/11 are import days)."
    },
