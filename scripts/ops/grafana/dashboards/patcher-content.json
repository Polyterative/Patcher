    {
      "id": 10,
      "title": "New racks + patches + profiles per week",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "patcher-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "patcher-pg"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select time, metric, n from (\n  select $__timeGroup(created, '1w') as time, 'racks' as metric, count(*) n from public.racks where $__timeFilter(created) group by 1\n  union all select $__timeGroup(created, '1w'), 'patches', count(*) from public.patches where $__timeFilter(created) group by 1\n  union all select $__timeGroup(created_at, '1w'), 'profiles', count(*) from public.profiles where $__timeFilter(created_at) group by 1) t\norder by time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "barAlignment": 0,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
