          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) as logins from auth.audit_log_entries where created_at > now() - interval '24 hours' and payload->>'action' = 'login'"
        }
