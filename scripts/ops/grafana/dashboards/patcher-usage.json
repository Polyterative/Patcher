    {
      "id": 4,
      "title": "Active users, last 7 days",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "patcher-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "patcher-pg"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(distinct u) as users from (\n  select user_id u from auth.sessions where coalesce(refreshed_at, created_at) > now() - interval '7 days'\n  union select (payload->>'actor_id')::uuid from auth.audit_log_entries\n   where created_at > now() - interval '7 days' and payload->>'action' in ('login','token_refreshed')) x where u is not null"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Users with a session created/refreshed or a logged login in the window."
    },
