    {
      "id": 14,
      "title": "Racks and patches: public vs private",
      "type": "piechart",
      "datasource": {
        "type": "postgres",
        "uid": "patcher-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 8
