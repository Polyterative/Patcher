      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "patcher-pg"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select m.name as module, count(*) as owners\nfrom public.user_modules um join public.modules m on m.id = um.moduleid where um.kind = 'HAS' group by m.id, m.name order by 2 desc limit 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlPu"
