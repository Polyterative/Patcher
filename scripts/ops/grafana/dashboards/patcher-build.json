    {
      "id": 7,
      "title": "Racks + patches built per week",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "patcher-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "patcher-pg"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select time, metric, n from (\n select $__timeGroup(created, '1w') as time, 'racks' as metric, count(*) n from public.racks where $__timeFilter(created) group by 1\n union all select $__timeGroup(created, '1w'), 'patches', count(*) from public.patches where $__timeFilter(created) group by 1) t order by time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "barAlignment": 0,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Rack size: how big do people build?",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "patcher-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "patcher-pg"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select bucket as \"modules in rack\", racks from (\n select case when n = 1 then '1' when n <= 5 then '2-5' when n <= 10 then '6-10' when n <= 20 then '11-20' else '21+' end bucket,\n   case when n = 1 then 1 when n <= 5 then 2 when n <= 10 then 3 when n <= 20 then 4 else 5 end o, count(*) racks\n from (select rackid, count(*) n from public.rack_modules group by 1) x group by 1, 2) t order by o"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "xField": "modules in rack",
        "legend": {
          "showLegend": false
        },
        "showValue": "always"
      }
    },
    {
      "id": 9,
      "title": "Racks per builder",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "patcher-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "patcher-pg"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select bucket as \"racks built\", people from (\n select case when n = 1 then '1' when n = 2 then '2' when n <= 5 then '3-5' when n <= 10 then '6-10' else '11+' end bucket,\n   case when n = 1 then 1 when n = 2 then 2 when n <= 5 then 3 when n <= 10 then 4 else 5 end o, count(*) people\n from (select authorid, count(*) n from public.racks where authorid is not null group by 1) x group by 1, 2) t order by o"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "xField": "racks built",
        "legend": {
          "showLegend": false
        },
        "showValue": "always"
      }
    },
    {
      "id": 10,
      "title": "Most used modules in racks",
      "type": "bargauge",
      "datasource": {
        "type": "postgres",
        "uid": "patcher-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "patcher-pg"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select m.name as module, count(distinct rm.rackid) as racks\nfrom public.rack_modules rm join public.modules m on m.id = rm.moduleid group by m.id, m.name order by 2 desc limit 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlPu"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "minVizHeight": 14,
        "namePlacement": "left"
      },
      "description": "Number of different racks each module appears in."
    },
    {
      "id": 11,
      "title": "Most owned modules",
      "type": "bargauge",
      "datasource": {
        "type": "postgres",
        "uid": "patcher-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 10
