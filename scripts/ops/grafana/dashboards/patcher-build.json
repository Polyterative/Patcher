      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "patcher-pg"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select what as kind, n as items from (\n select 'racks public' what, count(*) filter (where public) n from public.racks\n union all select 'racks private', count(*) filter (where not public) from public.racks\n union all select 'patches public', count(*) filter (where public) from public.patches\n union all select 'patches private', count(*) filter (where not public) from public.patches) t"
